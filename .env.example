# ===== 安全 =====
# 固定开发默认值；生产必换（随机值会导致重启全员掉线）
SECRET_KEY=dev-secret-key-change-me
JWT_EXPIRE_HOURS=24

# ===== 数据库 =====
# 本地 uv 直跑默认；compose 内由 docker-compose.yml 覆盖为 db:5432
DATABASE_URL=postgresql+psycopg2://rag:rag123@localhost:5432/rag_enterprise

# ===== LLM 双模 =====
# ollama | openai_compat
LLM_PROVIDER=ollama
# compose 内指向宿主机 Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
# qwen3 思考模式：true 时 thinking 以 SSE 流式转发；false 跳过思考更省时
OLLAMA_THINK=true
# 必须显式限制上下文，否则 KV cache 预分配挤爆 16GB 显存（见 architecture §4）
OLLAMA_NUM_CTX=8192

# LLM_PROVIDER=openai_compat 时使用（示例：OpenAI 官方）
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# 绝不提交真实 key
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini

# ===== 检索与分块 =====
RETRIEVAL_TOP_K=4
# cosine 空间 relevance=1-distance，低于阈值丢弃
RETRIEVAL_SCORE_THRESHOLD=0.3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== 存储 =====
CHROMA_PERSIST_DIR=chroma_data
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=50
